  border-radius: var(--radius-lg);
  padding: 40px 36px;
  box-shadow: var(--shadow-md);
}

.auth-brand__title {
  margin: 0;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.04em;
  color: var(--text);
}

.auth-brand__subtitle {
  margin: 3px 0 0;
  font-size: 12px;
  color: var(--muted);
}

.auth-divider {
  border: none;
  border-top: 1px solid var(--border);
  margin: 24px 0;
}

.auth-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 24px;
}

.auth-tab {
  padding: 6px 16px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: transparent;
  font-size: 13px;
  cursor: pointer;
  color: var(--muted);
  text-decoration: none;
  transition: all 0.15s ease;
}

.auth-tab:hover {
  background: var(--surface-2);
  color: var(--text);
}

.auth-tab--active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
  font-weight: 600;
}

.auth-heading {
  margin: 0 0 4px;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--text);
}

.auth-subheading {
  margin: 0 0 24px;
  font-size: 13px;
  color: var(--muted);
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.auth-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.auth-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
}

.auth-submit-btn {
  width: 100%;
  margin-top: 4px;
}

.auth-footer {
  margin: 22px 0 0;
  text-align: center;
  font-size: 13px;
  color: var(--muted);
}

.auth-link {
  color: var(--accent);
  font-weight: 600;
  text-decoration: none;
}

.auth-link:hover {
  text-decoration: underline;
}

/* ── Header actions ── */

.admin-header__actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* ── Añade esto al final del globals.css ── */

/* Icon button */
.icon-btn {
  width: 38px;
  height: 38px;
  padding: 0 !important;
  display: grid;
  place-items: center;
  border-radius: 10px;
}

/* Header actions */
.admin-header__actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Language dropdown */
.lang-dropdown {
  position: relative;
}

.lang-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px !important;
  border-radius: 10px;
}

.lang-flag {
  font-size: 16px;
  line-height: 1;
}

.lang-code {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--muted);
}

.lang-menu {
  position: fixed;
  top: auto;
  right: auto;
  margin-top: 6px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.14);
  overflow: hidden;
  z-index: 9999;
  min-width: 168px;
  animation: scaleIn 0.12s ease both;
  transform-origin: top right;
}

.lang-menu__item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 14px;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 13.5px;
  color: var(--text);
  text-align: left;
  transition: background 0.12s ease;
}

.lang-menu__item:hover {
  background: var(--surface-2);
}

.lang-menu__item--active {
  font-weight: 600;
  color: var(--accent);
}

/* User pill */
.user-pill {
  display: flex;
  align-items: center;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface);
  overflow: hidden;
}

.user-pill__email {
  padding: 0 12px;
  font-size: 12.5px;
  font-weight: 500;
  color: var(--muted);
  max-width: 160px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-pill__logout {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: none;
  border-left: 1px solid var(--border);
  background: none;
  cursor: pointer;
  color: var(--muted);
  transition: background 0.15s ease, color 0.15s ease;
}

.user-pill__logout:hover {
  background: #fef2f2;
  color: #dc2626;
}

.dark .user-pill__logout:hover {
  background: rgba(220, 38, 38, 0.12);
  color: #f87171;
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.95); }
  to   { opacity: 1; transform: scale(1); }
}
